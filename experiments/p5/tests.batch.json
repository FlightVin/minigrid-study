{
 "jobs": [
  {
   "id": "p5-tests",
   "cpu_threads": 1,
   "memory_gb": 2,
   "device": "cpu",
   "command": [
    "{python}",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider",
    "tests"
   ]
  },
  {
   "id": "p5-smoke",
   "cpu_threads": 1,
   "memory_gb": 2,
   "device": "cpu",
   "command": [
    "env",
    "BC2RL_SMOKE=1",
    "{python}",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider",
    "tests/test_rl_smoke.py",
    "tests/test_pause_smoke.py",
    "tests/test_p5_smoke.py"
   ]
  }
 ]
}
